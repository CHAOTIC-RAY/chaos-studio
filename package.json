{
  "name": "chaos-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Chaos Studio — creative studio site (Malé, Maldives) on Cloudflare Workers",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "pano:assets": "node scripts/generate-pano-thumbs.mjs",
    "build": "npm run sync:content && npm run pano:assets && node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
