{
  "id": "/admin/",
  "name": "Chaos Studio CMS",
  "short_name": "CMS Admin",
  "description": "Edit portfolio content, posts, and media from your phone.",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#6366f1",
  "background_color": "#f5f3ff",
  "lang": "en",
  "categories": ["productivity", "business"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "url": "/admin/#/",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Portfolio feed",
      "short_name": "Feed",
      "url": "/admin/#/collections/campaign/entries/social-posts",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Gallery posts",
      "short_name": "Gallery",
      "url": "/admin/#/collections/campaign/entries/gallery-posts",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pictures",
      "short_name": "Media",
      "url": "/admin/#/media",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI assistant",
      "short_name": "AI",
      "url": "/admin/#/assistant",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
