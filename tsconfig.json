{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["worker/**/*.ts", "content/site-content.defaults.json"],
  "exclude": ["node_modules", "frontend/dist", "worker/dist", "frontend"]
}
