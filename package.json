{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Ibrahim Wafig — graphic design portfolio on Cloudflare Workers",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "build": "npm run sync:content && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "wrangler deploy --dry-run"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
