{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design",
  "main": "worker/index.ts",
  "build": {
    "command": "sh -c 'test -n \"$WRANGLER_SKIP_BUILD\" || npm run build'"
  },
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT",
      "id": "cd318685a7f14897ac4b8960ac8f6a03",
      "preview_id": "cd318685a7f14897ac4b8960ac8f6a03"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cs-media",
      "preview_bucket_name": "cs-media"
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/gallery/*", "/admin", "/admin/*", "/media/*"]
  }
}
