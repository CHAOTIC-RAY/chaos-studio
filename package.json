{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Ibrahim Wafig — graphic design portfolio on Cloudflare Workers",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "import:posts": "node scripts/import-posts-zip.mjs",
    "apply:post-copy": "node scripts/apply-post-copy.mjs && npm run sync:content",
    "import:faisa": "node scripts/import-faisa-zip.mjs",
    "import:apps": "npm run import:faisa && node scripts/import-app-screenshots.mjs",
    "download:apps": "curl -sL \"https://drive.google.com/uc?export=download&id=1UUjwktcD_O1zNocCum121wjnb9Ybrnen\" -o AppScreenshots.zip",
    "download:logos": "curl -sL \"https://drive.google.com/uc?export=download&id=12hjtHPVEl27Q1kSh23bV_q7T7N9j_DmW\" -o AppLogos.zip",
    "import:logos": "node scripts/import-app-logos.mjs",
    "download:mdp": "curl -sL \"https://drive.google.com/uc?export=download&id=1-2PWDMXa0MkHTqSUeXohKxemhnyKN4j3\" -o MDP.zip",
    "import:mdp": "node scripts/import-mdp-campaign.mjs",
    "capture:cookxpert": "node scripts/capture-cookxpert.mjs",
    "capture:cookxpert:mobile": "node scripts/capture-cookxpert-mobile.mjs",
    "capture:forge:mobile": "node scripts/capture-forge-mobile.mjs",
    "crop:forge:mobile": "node scripts/crop-mobile-from-desktop.mjs forge",
    "crop:cookxpert:mobile": "node scripts/crop-mobile-from-desktop.mjs cookxpert",
    "crop:mobile": "npm run import:faisa && npm run crop:cookxpert:mobile && npm run crop:forge:mobile",
    "check:post-images": "node scripts/check-post-image-dupes.mjs",
    "optimize:media": "node scripts/optimize-media.mjs",
    "cms:local": "npx decap-server",
    "export:portfolio-json": "node scripts/export-portfolio-json.mjs",
    "build": "npm run sync:content && node scripts/check-post-image-dupes.mjs && node scripts/generate-icons.mjs && npm run build --workspace=frontend",
    "icons": "node scripts/generate-icons.mjs",
    "build:frontend": "npm run build --workspace=frontend",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "wrangler deploy --dry-run"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
