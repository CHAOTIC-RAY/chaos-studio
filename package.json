{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Ibrahim Wafig — graphic design portfolio on Cloudflare Workers",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "import:posts": "node scripts/import-posts-zip.mjs",
    "apply:post-copy": "node scripts/apply-post-copy.mjs && npm run sync:content",
    "build": "npm run sync:content && node scripts/generate-icons.mjs && npm run build --workspace=frontend",
    "icons": "node scripts/generate-icons.mjs",
    "build:frontend": "npm run build --workspace=frontend",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "wrangler deploy --dry-run"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
